# ─────────────────────────────────────────────────────────────────────────────
# SmartRecipe – Environment Variables
#
# Copy this file to .env and fill in your real values.
# NEVER commit the .env file to version control (it is in .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# ── IBM watsonx.ai Credentials ───────────────────────────────────────────────
#
# How to get these:
#   1. Sign up / log in at https://cloud.ibm.com
#   2. Create an IBM watsonx.ai service instance
#   3. Create a project at https://dataplatform.cloud.ibm.com
#   4. Copy your Project ID from the project settings page
#   5. Generate an API key at https://cloud.ibm.com/iam/apikeys
#
# Leave blank to run in Demo Mode (the app still works without credentials).

WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ── Flask Settings ────────────────────────────────────────────────────────────
# Set to "true" for hot-reload during development (never use in production)
FLASK_DEBUG=false

# Port to run the Flask server on (default: 5000)
PORT=5000
